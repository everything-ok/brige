PORT=18792
HOST=127.0.0.1

# 浏览器模式：cdp=连接系统Chrome复用登录态 / profile=独立持久化profile
# 2026-08: Chrome 151+ 禁止在默认用户数据目录开调试端口，cdp 模式已失效，
# 改用独立 profile（profiles/zai 内已有 chat.z.ai 登录态）
BROWSER_MODE=profile
# CDP_ENDPOINT=http://127.0.0.1:9222
# 调试端口(可选): 需要排查页面DOM时取消注释
BRIDGE_PROFILE_DEBUG_PORT=9223
# 浏览器可见性：1=真无头(默认,**完全不弹窗口**) / hidden=有头但移出屏幕 / 0=正常显示(仅人工登录时用)
# 人工登录用 POST /login/{site} 或 POST /login/batch，会临时切到可见窗口，登录完自动恢复。
BROWSER_HEADLESS=1

# OpenRouter 免费模型 Key：到 https://openrouter.ai/keys 免费创建，填入下面并去掉注释
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx